{
  "name": "chi-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.js --outdir dist --format esm --minify",
    "serve": "python3 -m http.server 8613",
    "sync-wasm": "wasm-pack build ../chi/chi-wasm --target web --release --out-name chi --out-dir ../../chi-playground/pkg && rm -f pkg/.gitignore",
    "sync-examples": "cp ../tree-sitter-chi/examples/*.chi examples/"
  },
  "dependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/view": "^6.28.0",
    "codemirror": "^6.0.1"
  }
}
