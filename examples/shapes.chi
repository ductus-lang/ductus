# Round shapes: circle, ellipse, rounded square, squircle, oval.
#
# Five glyphs cut from the same box. Four are a line each, now that the
# shape constructors exist. The fifth is written out point by point,
# because the designer owns the outline and because the egg has no
# constructor to hide behind.
#
# What this file exercises
#   circle, ellipse,
#   roundrect, superellipse     the shape constructors
#   sqrt, unitvec               the box half-diagonal guide
#   t[a, b]                     mediation places the oval's waist
#   yscaled, shifted            the squashed-circle guide
#   directionpoint, point,
#   intersection                probing the geometry that renders
#
# Measured limits, as the greatest distance from the fitted outline to the
# ideal curve it is approximating.
#   * Circles are exact; ellipses are not. The fitter lands on the classic
#     four-arc circle exactly — handles at 0.5523 r, 0.027 % of r out —
#     but its handle rule is not affine-equivariant, so squashing that
#     circle does not give a good ellipse. The dashed guide in the ellipse
#     glyph is that squash, standing 1.05 % of rx outside the contour it
#     ought to coincide with, because the fitter draws the vertical handle
#     15 % too long. Which is what the eight points of ellipse() buy:
#     0.062 %.
#   * Sampling sets a squircle's fidelity, not fitting. Sixteen samples
#     hold exponent 4 to 0.15 % of the side; by exponent 10 the corner has
#     outrun them, at 0.69 %, and thirty-two bring that back to 0.16 %.
#   * The sample count cannot follow the exponent, though: interpolation
#     compatibility fixes a contour's point count across the design space,
#     so it is a constant here and the slider has to live with one choice.
#   * Same rule at the other end: a corner radius of zero is a rectangle
#     with four zero-length segments, not a four-point path. That holds the
#     topology, but a zero-length segment has no tangent, so the path
#     queries cannot see it — which is why the corner slider stops just
#     short of zero rather than the shape needing it to.
#   * roundrect() clamps the top of its range itself, where neighbouring
#     arcs would start to overlap.
#   * No pi and no inverse trig beyond angle(): angles are degrees
#     everywhere, so neither has come up.

params {
  size     = 560 in 240..700;   # the box: side length, before overshoot
  aspect   = 0.72 in 0.35..1.0; # ellipse: height / width
  corner   = 0.28 in 0..1;      # rounded square: corner radius / side
  exponent = 4 in 2..10;        # squircle: superellipse exponent
  waist    = 0.40 in 0.28..0.5; # oval: height of the widest point / height
}

metrics {
  upm  = 1000;
  cap  = size;        # the box top; every shape sits on the baseline
  x    = 0.5 size;    # half-height, for reference in --debug
  asc  = 800;
  desc = -100;
  over = size / 55;   # round shapes overshoot the flat ones
}

sb = 60;              # sidebearing, same on every glyph

# Centre to box corner: the direction every shape in the square box
# reaches for, and the length none of them reaches.
def corner_guide(c) -> g {
  g = c -- c + (sqrt(2) * size / 2) * unitvec(45);
}

glyph circle {
  advance = size + 2 sb;
  center  = (advance / 2, size / 2);
  r       = size / 2 + over;

  contour main = circle(center, r);

  guide box = corner_guide(center);

  # The fitter's own error, measured from inside the language: read these
  # with `chi inspect` or in the playground's inspector. The handle length
  # is chosen so the arc passes exactly through 45°, which is the midpoint
  # of the first segment — so `waist` is zero, and the error lives between,
  # peaking near t = 0.21 at 0.027 % of r.
  waist = distance(point(main, 0.5), center) - r;   #  0
  bulge = distance(point(main, 0.2), center) - r;   #  0.0787 at r = 290

  # Three queries, one point: the tangent turns 135° exactly where segment
  # time reaches 0.5 and where the diagonal crosses, so on a circle all
  # three anchors land together. They read the fitted geometry, not the
  # source points.
  anchor corner = directionpoint(main, 135);
  anchor mid    = point(main, 0.5);

  # How far the shape reaches along the box diagonal — what the guide is
  # there to compare. 0.73 of the half-diagonal at these defaults, against
  # 0.84 for the rounded square and 0.86 for the squircle.
  anchor reach = intersection(main, box);
}

glyph ellipse {
  advance = size + 2 sb;
  center  = (advance / 2, aspect * size / 2);
  rx      = size / 2 + over;
  ry      = aspect * rx;

  contour main = ellipse(center, rx, ry);

  # The four-point circle, squashed — the construction that is exact for a
  # circle and 1.05 % out for its own image under a squash. In --debug it
  # is the dashed outline standing just clear of the contour near 39°.
  guide squashed = circle((0, 0), rx) yscaled aspect shifted center;

  anchor corner = directionpoint(main, 135);
}

glyph roundsquare {
  advance = size + 2 sb;
  center  = (advance / 2, size / 2);

  # The slider runs past 0.5, where neighbouring arcs would overlap;
  # roundrect() holds the radius at half the shorter side, so the shape
  # stops at the circle rather than turning itself inside out. The floor
  # here is not about the shape — roundrect() is happy at zero — but about
  # the probe below: a zero-length segment has no tangent, so there would
  # be no 135° on the outline to find.
  contour main = roundrect((sb, 0), (sb + size, size), max(0.02, corner) * size);

  guide box = corner_guide(center);
  anchor corner = directionpoint(main, 135);
  anchor reach  = intersection(main, box);
}

glyph squircle {
  advance = size + 2 sb;
  center  = (advance / 2, size / 2);

  # Overshoot in proportion to how round the shape still is: exponent 2 is
  # a circle and takes the full amount, a high exponent is nearly a square
  # and takes almost none.
  r = size / 2 + 2 over / exponent;

  contour main = superellipse(center, r, r, exponent, 16);

  guide box = corner_guide(center);
  anchor corner = directionpoint(main, 135);
  anchor reach  = intersection(main, box);
}

glyph oval {
  advance = size + 2 sb;

  # An egg, by hand. Same height as the rest, but the widest point sits
  # below the middle: `waist[0, size]` is mediation — waist of the way
  # from the baseline to the top — so the two ends stay unequal at any
  # size. The narrow end is not a separate construction; it is just the
  # longer of the two domes over the same half-width. At waist = 0.5 it is
  # an ellipse, and the same four points describe both.
  cx = advance / 2;
  rx = 0.38 size;
  yw = waist[0, size];

  contour main =
      (cx + rx, yw)        {up}
   .. (cx, size + over)    {left}
   .. (cx - rx, yw)        {down}
   .. (cx, -over)          {right}
   .. cycle;

  guide axis = (cx, -over) -- (cx, size + over);
  anchor corner = directionpoint(main, 135);
}
