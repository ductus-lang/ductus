params {
  shade = 46 in 12..90; # full-pressure pen width
  contrast = 11 in 3..24; # shade / hairline
  aspect = 35 in 10..100; # pen height as a percentage of its width
  penangle = 20 in 0..180; # angle of the pen's major axis
  xheight = 250 in 150..320;
}

metrics {
  upm = 1000;
  x = xheight;
  asc = 2.6xheight; # engrosser's proportions are extreme
  desc = -1.3xheight;
  cap = 2xheight;
  u = upm / 100;
  slant = 55;
}

hair = shade / contrast;
aw = 0.66x; # arch width: the run of one letter part
sb = 0.18x; # sidebearing

# The nib at full pressure: an ellipse. Its .left/.right are the true
# contact points of the moving ellipse, so the banks are envelope edges,
# and .tip/.tail trace its round ends for the terminals.
pen brush {
  width = shade;
  height = aspect * shade / 100;
  angle = penangle;
}

# A pressure sample: a node on the pen path at segment time `t`, the whole
# nib scaled by pressure — 0 for a shut pen, 1 for full weight. Width and
# height shrink together, so aspect and angle never change, and a shut pen
# still prints a hairline-sized ellipse, not a point. The node is built at
# the origin because `scaled` works about the origin, then shifted out.
def press(path, t, pressure) -> n {
  squeeze = (hair + pressure * (shade - hair)) / shade;
  node m = (0, 0) dir direction(path, t) pen brush;
  n = m scaled squeeze shifted point(path, t);
}

glyph wave {
  advance = 60u;
  guide spine = (0, 0) .. (20u, 20u) .. (40u, 0) .. (60u, 20u);
  a = press(spine, 0, 0);
  b = press(spine, 1, 0.22);
  c = press(spine, 2, 0.73);
  d = press(spine, 3, 1);

  # Right bank out, around the d terminal, left bank back, closing over
  # the a terminal. The caps are exact half-ellipses: they splice in with
  # their own endpoints and tangents, so the banks just connect to them.
  contour outline = a.tailcap
      .. b.right {b.dir}
      .. c.right {c.dir}
      .. d.tipcap
      .. c.left {c.dir + 180}
      .. b.left {b.dir + 180}
      .. cycle;
}
