params {
  shade = 46 in 12..80; # full-pressure pen width
  contrast = 11 in 3..24; # shade / hairline
  aspect = 35 in 10..100; # pen height as a percentage of its width

  xheight = 250 in 150..320;
}

metrics {
  upm = 1000;
  x = xheight;
  asc = 2.6xheight; # engrosser's proportions are extreme
  desc = -1.3xheight;
  cap = 2xheight;
  u = upm / 100;
  slant = 20;
}

hair = shade / contrast;
aw = 0.66x; # arch width: the run of one letter part
sb = 0.18x; # sidebearing

# The nib at full pressure: an ellipse. Its .left/.right are the true
# contact points of the moving ellipse, so the banks are envelope edges,
# and .tip/.tail trace its round ends for the terminals.
pen brush {
  width = shade;
  height = aspect * shade / 100;
  angle = 0;
}

# A pressure sample: a node on the pen path at segment time `t`, the whole
# nib scaled by pressure — 0 for a shut pen, 1 for full weight. Width and
# height shrink together, so aspect and angle never change, and a shut pen
# still prints a hairline-sized ellipse, not a point. The node is built at
# the origin because `scaled` works about the origin, then shifted out.
def press(path, t, pressure) -> n {
  squeeze = (hair + pressure * (shade - hair)) / shade;
  node m = (0, 0) dir direction(path, t) pen brush;
  n = m scaled squeeze shifted point(path, t);
}

glyph entrance {
  advance = x / 2;
  r = x / 2; # half the oval's width

  center = (x / 4, 0.75x);
  guide spine = ellipse(center, x / 3, 0.75x) slanted tan(slant);
  k = tan(slant);
  a = press(spine, 0.85 - k, 0);
  b = press(spine, 1 - k, 0);
  c = press(spine, 2 - k, 0.1);
  d = press(spine, 3 - k, 0.8);
  e = press(spine, 3.9 - k, 1);
  f = press(spine, 5 - k, 0.8);
  g = press(spine, 6, 0.4);
  h = press(spine, 7 - k, 0);

  contour outer = g.right {g.dir}
      .. h.right {h.dir}
      .. a.right
      -- a.left
      .. h.left {h.dir + 180}
      .. g.left
      -- cycle;
}

glyph oval {
  advance = x / 2;

  center = (x / 4, x / 2);
  guide spine = ellipse(center, x / 4, x / 2) slanted tan(slant);
  k = tan(slant);
  a = press(spine, 8 - k, 0);
  b = press(spine, 1 - k, 0);
  c = press(spine, 2 - k, 0.1);
  d = press(spine, 3 - k, 0.8);
  e = press(spine, 4 - k, 1);
  f = press(spine, 5 - k, 0.8);
  g = press(spine, 6 - k, 0.4);
  h = press(spine, 7 - k, 0);

  contour outer = a.right
      .. b.right
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      .. g.right
      .. h.right
      .. cycle;
  contour counter = a.left
      .. h.left
      .. g.left
      .. f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. cycle;
}

glyph c {
  advance = x / 2;

  center = (x / 4, x / 2);
  guide spine = ellipse(center, x / 4, x / 2) slanted tan(slant);
  guide spineB = ellipse(center + (0.2x, 0), x / 4, x / 2) slanted tan(slant);
  k = tan(slant);
  a = press(spine, k, 0);
  b = press(spine, 1 - k, 0);
  c = press(spine, 2 - k, 0.1);
  d = press(spine, 3 - k, 0.8);
  e = press(spine, 4 - k, 1);
  f = press(spine, 5 - k, 0.8);
  g = press(spine, 6 - k, 0.4);
  h = press(spineB, 7 - k, 0);
  i = press(spineB, 8 - k, 0);
  contour outer = a.right
      .. b.right
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      .. g.right
      .. h.right
      .. i.right
      -- i.left
      .. h.left
      .. g.left
      .. f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. a.left
      -- cycle;
}

glyph e {
  advance = x / 2;

  center = (x / 4, x / 2);
  guide spine = ellipse(center, x / 4, x / 2) slanted tan(slant);
  guide spineB = ellipse(center + (0.1x, 0), x / 4, x / 2) slanted tan(slant);
  k = tan(slant);
  a = press(spine, k, 0);
  b = press(spine, 1 - k, 0);
  c = press(spine, 2 - k, 0.1);
  d = press(spine, 3 - k, 0.8);
  e = press(spine, 4 - k, 1);
  f = press(spine, 5 - k, 0.8);
  g = press(spine, 6 - k, 0.4);
  h = press(spineB, 7 - k, 0);
  i = press(spineB, 8 - k, 0);

  s = press(spineB, 4.5 - k, 0.1);
  contour outer = s.right
      .. b.right
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      .. g.right
      .. h.right
      .. i.right
      -- i.left
      .. h.left
      .. g.left
      .. f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. s.left
      -- cycle;
}

glyph underturn {
  advance = x / 2;

  center = (x / 4, 0.75x);
  guide spine = ellipse(center, x / 3, 0.75x) slanted tan(slant);
  k = tan(slant);
  a = press(spine, 0.85 - k, 0);
  b = press(spine, 1 - k, 0);
  c = press(spine, 2 - k, 0.1);
  d = press(spine, 3 - k, 0.8);
  e = press(spine, 3.9 - k, 1);
  f = press(spine, 5 - k, 0.8);
  g = press(spine, 6 - k, 0.4);
  h = press(spine, 7 - k, 0);

  contour outer = e.tailcap
      .. f.right
      .. g.right
      .. h.right {h.dir}
      .. a.right
      -- a.left
      .. h.left {h.dir + 180}
      .. g.left
      .. f.left
      -- cycle;
}

glyph overturn {
  advance = x / 2;
  r = x / 2; # half the oval's width

  center = (x / 4, 0.25x);
  guide spine = ellipse(center, x / 3, 0.75x) slanted tan(slant);
  k = tan(slant);
  a = press(spine, 7.9 - k, 1);
  b = press(spine, 1 - k, 0.6);
  c = press(spine, 2 - k, 0.2);
  d = press(spine, 3 - k, 0);
  e = press(spine, 4 - k, 0);
  f = press(spine, 4.85 - k, 0);
  g = press(spine, 6 - k, 0.4);
  h = press(spine, 7 - k, 0);

  contour outer = f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. a.tailcap
      .. b.right
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      -- cycle;
}

glyph compound {
  advance = x;
  centerA = (x / 4, 0.25x);
  guide spineA = ellipse(centerA, x / 3, 0.75x) slanted tan(slant);
  centerB = centerA + (0.5x, 0.5x);
  guide spineB = ellipse(centerB, x / 3, 0.75x) slanted tan(slant);
  k = tan(slant);
  a1 = press(spineA, 7.9 - k, 1);
  b1 = press(spineA, 1 - k, 0.6);
  c1 = press(spineA, 2 - k, 0.2);
  d1 = press(spineA, 3 - k, 0);
  e1 = press(spineA, 4 - k, 0);
  f1 = press(spineA, 5 - k, 0);
  g1 = press(spineA, 6 - k, 0.4);
  h1 = press(spineA, 7 - k, 0);

  a2 = press(spineB, 8 - k, 0);
  b2 = press(spineB, 1 - k, 0);
  c2 = press(spineB, 2 - k, 0.1);
  d2 = press(spineB, 3 - k, 0.8);
  e2 = press(spineB, 3.9 - k, 1);
  f2 = press(spineB, 5 - k, 0.8);
  g2 = press(spineB, 6 - k, 0.6);
  h2 = press(spineB, 7 - k, 0);

  # mid point between b1 and g2 with more pressure
  bg = press(b1.pos {b1.dir + 180} .. {g2.dir} g2.pos, 0.5, 0.8);

  contour outer = e1.right
      .. d1.right
      .. c1.right
      .. b1.right
      .. bg.left
      .. g2.left
      .. h2.left {h2.dir}
      .. a2.left
      -- a2.right
      .. h2.right {h2.dir + 180}
      .. g2.right
      .. bg.right
      .. b1.left
      .. c1.left
      .. d1.left
      .. e1.left
      -- cycle;
}

glyph ascender {
  advance = 0.4x;
  centerA = (x / 4, 0.25x);
  guide spine = (sb, 0) {90 - slant}
      .. {90 - slant} (sb + cos(90 - slant) * asc - 5u, asc - 5u)
      .. (sb + cos(90 - slant) * asc + u, asc - 16u)
      .. (sb + cos(90 - slant) * x, 0.9x) {90 - slant + 180};

  k = tan(slant);
  a = press(spine, 0, 1);
  b = press(spine, 0.33, 0.8);
  c = press(spine, 0.7, 0.4);
  c1 = press(spine, 1, 0.2);
  c2 = press(spine, 1.5, 0.1);
  d = press(spine, 2, 0.1);
  e = press(spine, 3, 0);

  contour outer = a.tailcap
      .. b.right {b.dir}
      .. c.right {c.dir}
      .. c1.right {c1.dir}
      .. c2.right {c2.dir}
      .. d.right {d.dir}
      .. e.right
      -- e.left
      .. d.left {d.dir + 180}
      .. c2.left {c2.dir + 180}
      .. c1.left {c1.dir + 180}
      .. c.left {c.dir + 180}
      .. b.left {b.dir + 180}
      -- cycle;
}

glyph descender {
  advance = 0.5x;
  centerA = (x / 4, 0.25x);
  aw = x;
  guide spine = (aw, x) {90 - slant + 180}
      .. {90 - slant + 180} (aw - cos(90 - slant + 180) * desc, desc + 5u) {90 - slant + 180}
      .. (aw - cos(90 - slant + 180) * desc, desc + 16u)
      .. (aw + u, 0.1x) {90 - slant};

  k = tan(slant);
  a = press(spine, 0, 1);
  b = press(spine, 0.33, 0.8);
  c = press(spine, 0.7, 0.4);
  c1 = press(spine, 1, 0.2);
  c2 = press(spine, 1.5, 0.1);
  d = press(spine, 2, 0.1);
  e = press(spine, 3, 0);

  contour outer = a.tailcap
      .. b.right {b.dir}
      .. c.right {c.dir}
      .. c1.right {c1.dir}
      .. c2.right {c2.dir}
      .. d.right {d.dir}
      .. e.right
      -- e.left
      .. d.left {d.dir + 180}
      .. c2.left {c2.dir + 180}
      .. c1.left {c1.dir + 180}
      .. c.left {c.dir + 180}
      .. b.left {b.dir + 180}
      -- cycle;
}

glyph l {
  advance = x;
  center = (x / 4, 0.75x);
    k = tan(slant);
  guide spine = (cos(90 - slant) * x, 0.9x)
      .. ( cos(90 - slant) * asc + 6u, asc - 16u) {90 - slant}
      .. {90 - slant + 180} (cos(90 - slant) * asc, asc - 5u)
      .. (cos(90 - slant) * 0.4x, 0.4x) {90 - slant + 190}
      ;
      
  guide spineA = ellipse(center, x / 3, 0.75x) slanted tan(slant);

  a = press(spine, 0, 0.1);
  b = press(spine, 1, 0.1);
  c1 = press(spine, 1.3, 0.1);
  c = press(spine, 2.2, 0.8);
  

  d = press(spine, 2.5, 1);
  e = press(spineA, 4-k, 1);
  f = press(spineA, 5-k, 0.6);
  g = press(spineA, 6, 0.2);
  h = press(spineA, 7, 0.1);
  i = press(spineA, 8, 0);

  contour outer = a.right {a.dir}
      .. b.right {b.dir}
      .. c1.right
      .. c.right {c.dir}
      .. d.right {d.dir}
      .. e.right {e.dir}
      .. f.right {f.dir}
      .. g.right {g.dir}
      .. h.right {h.dir}
      .. i.right
      -- i.left
      .. h.left {h.dir + 180}
      .. g.left {g.dir + 180}
      .. f.left {f.dir + 180}
      .. e.left {e.dir + 180}
      .. d.left {d.dir + 180}
      .. c.left {c.dir + 180}
      .. c1.left {c1.dir + 180}
      .. b.left {b.dir + 180}
      .. {a.dir + 180} a.left
      -- cycle;
}

glyph t {
  advance = x;
  k = tan(slant);

  center = (x / 4, 0.75x);
  guide spineA = ellipse(center, x / 3, 0.75x) slanted tan(slant);

  guide spineB = (cos(90 - slant) * asc, asc) .. point(spineA, 4);

  a = press(spineB, 0, 1);
  b = press(spineB, 1 - k, 1);
  c = press(spineA, 5 - k, 0.8);
  d = press(spineA, 6 - k, 0.4);
  e = press(spineA, 7 - k, 0.2);
  f = press(spineA, 8 - k, 0.1);
  contour outer = a.tailcap
      .. b.right {b.dir}
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      -- f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      -- cycle;
}


glyph L {
  advance = 60u;
  guide spineA = (10u, cap) {down}
      .. (30u, 0.55cap)
      .. (50u, 0.75cap) {up}
      .. (30u, cap);

  a1 = press(spineA, 0, 1);
  b1 = press(spineA, 1, 1);
  c1 = press(spineA, 2, 1);
  d1 = press(spineA, 3, 1);

  # Right bank out, around the d terminal, left bank back, closing over
  # the a terminal. The caps are exact half-ellipses: they splice in with
  # their own endpoints and tangents, so the banks just connect to them.
  contour outlineA = a1.tailcap
      .. b1.right {b1.dir}
      .. c1.right {c1.dir}
      .. d1.tipcap
      .. c1.left {c1.dir + 180}
      .. b1.left {b1.dir + 180}
      .. cycle;
  guide spineB = (30u, cap) {down}
      .. (30u, cap / 2)
      .. (10u, 0) {left}
      .. (0, 6u)
      .. (10u, 15u)
      .. (30u, 0)
      .. (50u, 5u)
      .. (40u, 20u);

  a2 = press(spineB, 0, 1);
  b2 = press(spineB, 1, 1);
  c2 = press(spineB, 2, 1);
  d2 = press(spineB, 3, 1);
  e2 = press(spineB, 4, 1);
  f2 = press(spineB, 5, 1);
  g2 = press(spineB, 6, 1);
  h2 = press(spineB, 7, 1);
  contour outlineB = a2.tailcap
      .. b2.right {b2.dir}
      .. c2.right {c2.dir}
      .. d2.right {d2.dir}
      .. e2.right {e2.dir}
      .. f2.right {f2.dir}
      .. g2.right {g2.dir}
      .. h2.tipcap
      .. g2.left {g2.dir + 180}
      .. f2.left {f2.dir + 180}
      .. e2.left {e2.dir + 180}
      .. d2.left {d2.dir + 180}
      .. c2.left {c2.dir + 180}
      .. b2.left {b2.dir + 180}
      .. cycle;
}
