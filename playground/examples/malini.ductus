# Malayalam samples
# With the weight, contrast and pen_angles, these examples
# can reproduce Manjari, Gayathri, Nupuram designs.
# Manjari has contrast = 1, pen_angle=0.
# Gayathri has contrast = 2, pen_angle=0.
# Nupuram has contrast = 2, pen_angle=90.
params {
  weight = 400 in 100..900;
  contrast = 1 in 1..2;
  pen_angle = 45 in 0..90;
}

metrics {
  upm = 1024;
  x = upm / 2;
  cap = 700;
  asc = 750;
  desc = -220;
  over = 0.01 * upm;
}

stem = (weight / 10);
brush = pen(weight * 0.2 * contrast, weight * 0.1, pen_angle);
pen_start = pen(stem, 2, pen_angle);
pen_end = pen(stem * 1.2, 2, pen_angle + 90);
pen_mid = pen(stem * 2, 2, pen_angle);
pen_mid_down = pen(stem * 2.6, 2, pen_angle);
pen_bottom = pen(stem * 1.2, 2, pen_angle);
pen_top = pen(stem * 1.6, 2, pen_angle);

# Mirror a node across the vertical line at `axis`. Direction is
# negated (mirror plus travel reversal), so the mirrored node reads
# correctly in a traversal that runs the other way. Symmetric widths
# only.
def mirror(n, axis, _pen) -> m {
  node m = (2 * axis - n.pos.x, n.pos.y) dir -n.dir pen _pen;
}

glyph tha : U+0D24 {
  u = upm / 10;
  advance = 7u;
  mid = 3.5u;

  node a = (1.2u, 0) dir 150 pen pen_start;
  node b = (0, x / 2) dir up pen pen_mid;
  node c = (b.pos.x + 2.5u, x - over) dir right pen pen_top;
  node d = (b.pos.x + 5.0u, x / 2) dir down pen pen_mid_down;
  node e = (mid, over) dir left pen pen_bottom;

  # Right half by symmetry.
  f = mirror(d, mid, pen_mid);
  g = mirror(c, mid, pen_top);
  h = mirror(b, mid + 0.1u, pen_mid_down);
  i = mirror(a, mid + 0.1u, pen_end);

  guide skeleton = a.pos
      .. b.pos
      .. c.pos
      .. d.pos
      .. e.pos {left}
      .. f.pos {up}
      .. g.pos
      .. h.pos
      .. i.pos;

  contour main = {a.dir} a.right {a.dir}
      .. b.right
      .. c.right
      .. d.right {d.dir}
      .. e.right
      .. f.right
      .. g.right
      .. h.right {h.dir}
      .. {i.dir} i.right {i.dir}
      .. i.tipcap
      .. {i.dir + 180} i.left {i.dir + 180}
      .. h.left
      .. g.left
      .. f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. a.left {a.dir + 180}
      .. a.tailcap
      .. cycle;
}

glyph Ra : U+0D31 {
  u = upm / 10;
  advance = 5u;
  mid = 4u;

  node a = (1.6u, 0) dir 160 pen pen_start;
  node b = (0, x / 2) dir up pen pen_mid;
  node c = (2.5u, x - over) dir right pen pen_top;
  node d = (b.pos.x + 5u, b.pos.y) dir down pen pen_mid_down;
  node e = (d.pos.x - 1.6u, 0) dir 200 pen pen_end;

  guide skeleton = a.pos .. b.pos .. c.pos .. d.pos .. e.pos;

  contour main = {a.dir} a.right {a.dir}
      .. b.right
      .. c.right
      .. d.right
      .. {e.dir} e.right {e.dir}
      .. e.tipcap
      .. {e.dir + 180} e.left {e.dir + 180}
      .. d.left
      .. c.left
      .. b.left
      .. a.left {a.dir + 180}
      .. a.tailcap
      .. cycle;
}

glyph ra : U+0D30 {
  u = upm / 10;
  advance = 4u;
  mid = 3.6u;

  node a = (1.5u, 0) dir 150 pen pen_start;
  node b = (0, x / 2) dir up pen pen_mid;
  node c = (b.pos.x + 2.5u, x - over) dir right pen pen_top;
  node d = (b.pos.x + 5u, x / 2.26) dir down pen pen_mid_down;
  node e = (3.5u, over) dir left pen pen_bottom;

  # Right half by symmetry.
  f = mirror(d, mid, pen_mid);

  guide skeleton = a.pos .. b.pos .. c.pos .. d.pos .. e.pos {left} .. f.pos;

  node g = directionpoint(skeleton, 320) dir 15 pen pen_end;
  contour main = {a.dir} a.right {a.dir}
      .. b.right
      .. c.right
      .. d.right
      .. e.right
      .. f.right
      .. {g.dir} g.right {g.dir}
      -- g.left {g.dir + 180}
      .. f.left
      .. e.left
      .. d.left
      .. c.left
      .. b.left
      .. a.left {a.dir + 180}
      .. a.tailcap
      .. cycle;
}
